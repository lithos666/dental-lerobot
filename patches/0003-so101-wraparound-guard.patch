+            # --- Wrap-around guard ------------------------------------------------
+            # Feetech STS3215 in POSITION mode reports positions in [0, 4095].
+            # The homing offset shifts the electrical zero, so when the shaft
+            # drifts past the wrap point the reported position jumps by ~4096
+            # counts in one cycle.  The normalization layer clamps this into
+            # [-100, 100], producing a large discontinuity that makes
+            # ensure_safe_goal_position push the goal in the WRONG direction.
+            #
+            # Detection: if any motor's normalized position changes by more than
+            # _WRAP_THRESHOLD between consecutive cycles, the reading is corrupt.
+            # Recovery: fall back to the last known-good position for clamping so
+            # the follower holds steady instead of reversing.
+            if self._last_present_pos is not None:
+                for motor, pos in present_pos.items():
