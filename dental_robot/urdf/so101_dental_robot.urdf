<?xml version="1.0" encoding="utf-8"?>
<!--
  SO-101 Dental Surgery Robot - URDF Model
  ==========================================
  Based on SO-ARM101 (TheRobotStudio) 6-DOF follower arm, adapted for
  dental surgery applications in the LeRobot dental_robot project.

  Joint naming matches LeRobot's SO101Follower motor bus exactly:
    shoulder_pan (ID 1)  - base yaw rotation
    shoulder_lift (ID 2) - shoulder pitch
    elbow_flex (ID 3)    - elbow pitch
    wrist_flex (ID 4)    - wrist pitch
    wrist_roll (ID 5)    - wrist roll
    gripper (ID 6)       - parallel gripper open/close

  Units: SI (meters, kilograms). All values are best-effort estimates
  based on SO-ARM101 CAD dimensions and printed part weights (~42mm
  STS3215 servo = 55g each). Refine masses/inertias if you have the
  official CAD export.

  Zero pose convention: arm standing upright, gripper pointing up,
  matching LeRobot calibration zero positions.
-->
<robot name="so101_dental_robot">

  <!-- ============================ Materials ============================ -->
  <material name="so101_black">
    <color rgba="0.15 0.15 0.15 1.0"/>
  </material>
  <material name="so101_blue">
    <color rgba="0.2 0.4 0.8 1.0"/>
  </material>
  <material name="so101_gripper">
    <color rgba="0.6 0.6 0.6 1.0"/>
  </material>

  <!-- ============================ Base Link ============================ -->
  <!-- Fixed mounting base plate (clamped/bolted to the surgery table) -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.013" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.055" length="0.026"/>
      </geometry>
      <material name="so101_black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.013" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.055" length="0.026"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.013" rpy="0 0 0"/>
      <mass value="0.30"/>
      <inertia ixx="0.0003" ixy="0" ixz="0" iyy="0.0003" iyz="0" izz="0.0005"/>
    </inertial>
  </link>

  <!-- ===================== J1: Shoulder Pan (Yaw) ====================== -->
  <joint name="shoulder_pan" type="revolute">
    <parent link="base_link"/>
    <child link="shoulder_yaw_link"/>
    <origin xyz="0 0 0.026" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <!-- STS3215 is 360-degree capable; limits match typical SO-101 usage -->
    <limit lower="-3.14159" upper="3.14159" effort="10.0" velocity="6.28"/>
    <dynamics damping="0.1" friction="0.05"/>
  </joint>

  <link name="shoulder_yaw_link">
    <visual>
      <origin xyz="0 0 0.035" rpy="0 0 0"/>
      <geometry>
        <box size="0.06 0.06 0.07"/>
      </geometry>
      <material name="so101_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.035" rpy="0 0 0"/>
      <geometry>
        <box size="0.06 0.06 0.07"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.035" rpy="0 0 0"/>
      <mass value="0.15"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <!-- ==================== J2: Shoulder Lift (Pitch) ==================== -->
  <joint name="shoulder_lift" type="revolute">
    <parent link="shoulder_yaw_link"/>
    <child link="upper_arm_link"/>
    <origin xyz="0 0 0.07" rpy="0 1.5708 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.74533" upper="1.74533" effort="10.0" velocity="6.28"/>
    <dynamics damping="0.1" friction="0.05"/>
  </joint>

  <link name="upper_arm_link">
    <visual>
      <!-- SO-101 upper arm beam length ~118mm -->
      <origin xyz="0 0 0.059" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.045 0.118"/>
      </geometry>
      <material name="so101_black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.059" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.045 0.118"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.059" rpy="0 0 0"/>
      <mass value="0.12"/>
      <inertia ixx="0.00015" ixy="0" ixz="0" iyy="0.00015" iyz="0" izz="0.00004"/>
    </inertial>
  </link>

  <!-- ======================= J3: Elbow Flex ============================ -->
  <joint name="elbow_flex" type="revolute">
    <parent link="upper_arm_link"/>
    <child link="forearm_link"/>
    <origin xyz="0 0 0.118" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.74533" upper="1.74533" effort="10.0" velocity="6.28"/>
    <dynamics damping="0.1" friction="0.05"/>
  </joint>

  <link name="forearm_link">
    <visual>
      <!-- SO-101 forearm beam length ~144mm -->
      <origin xyz="0 0 0.072" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.045 0.144"/>
      </geometry>
      <material name="so101_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.072" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.045 0.144"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.072" rpy="0 0 0"/>
      <mass value="0.13"/>
      <inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.00005"/>
    </inertial>
  </link>

  <!-- ======================= J4: Wrist Flex ============================ -->
  <joint name="wrist_flex" type="revolute">
    <parent link="forearm_link"/>
    <child link="wrist_link"/>
    <origin xyz="0 0 0.144" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.74533" upper="1.74533" effort="10.0" velocity="6.28"/>
    <dynamics damping="0.1" friction="0.05"/>
  </joint>

  <link name="wrist_link">
    <visual>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry>
        <box size="0.035 0.04 0.06"/>
      </geometry>
      <material name="so101_black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry>
        <box size="0.035 0.04 0.06"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <mass value="0.08"/>
      <inertia ixx="0.00005" ixy="0" ixz="0" iyy="0.00005" iyz="0" izz="0.00002"/>
    </inertial>
  </link>

  <!-- ======================= J5: Wrist Roll ============================ -->
  <joint name="wrist_roll" type="revolute">
    <parent link="wrist_link"/>
    <child link="gripper_base_link"/>
    <origin xyz="0 0 0.06" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159" effort="10.0" velocity="6.28"/>
    <dynamics damping="0.1" friction="0.05"/>
  </joint>

  <link name="gripper_base_link">
    <visual>
      <origin xyz="0 0 0.015" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.045 0.03"/>
      </geometry>
      <material name="so101_gripper"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.015" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.045 0.03"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.015" rpy="0 0 0"/>
      <mass value="0.06"/>
      <inertia ixx="0.00003" ixy="0" ixz="0" iyy="0.00003" iyz="0" izz="0.00002"/>
    </inertial>
  </link>

  <!-- ============ J6: Gripper (prismatic approximation) ================ -->
  <!-- The SO-101 gripper is a single-servo rotational jaw; modeled here
       as a prismatic joint on jaw separation for RL/IK friendliness.
       LeRobot gripper value 0=closed, 100=open maps to separation 0-0.06m -->
  <joint name="gripper" type="prismatic">
    <parent link="gripper_base_link"/>
    <child link="gripper_jaw_left"/>
    <origin xyz="0 0 0.03" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0.0" upper="0.03" effort="5.0" velocity="1.0"/>
    <dynamics damping="0.05" friction="0.02"/>
  </joint>

  <link name="gripper_jaw_left">
    <visual>
      <origin xyz="0 -0.004 0.028" rpy="0 0 0"/>
      <geometry>
        <box size="0.01 0.008 0.056"/>
      </geometry>
      <material name="so101_gripper"/>
    </visual>
    <collision>
      <origin xyz="0 -0.004 0.028" rpy="0 0 0"/>
      <geometry>
        <box size="0.01 0.008 0.056"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 -0.004 0.028" rpy="0 0 0"/>
      <mass value="0.02"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.000005"/>
    </inertial>
  </link>

  <!-- Right jaw: mirrored fixed joint (single actuator drives both) -->
  <joint name="gripper_jaw_right_joint" type="fixed">
    <parent link="gripper_base_link"/>
    <child link="gripper_jaw_right"/>
    <origin xyz="0 0 0.03" rpy="0 0 0"/>
  </joint>

  <link name="gripper_jaw_right">
    <visual>
      <origin xyz="0 0.004 0.028" rpy="0 0 0"/>
      <geometry>
        <box size="0.01 0.008 0.056"/>
      </geometry>
      <material name="so101_gripper"/>
    </visual>
    <collision>
      <origin xyz="0 0.004 0.028" rpy="0 0 0"/>
      <geometry>
        <box size="0.01 0.008 0.056"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0.004 0.028" rpy="0 0 0"/>
      <mass value="0.02"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.000005"/>
    </inertial>
  </link>

  <!-- ================= Dental Tool TCP Frame ========================== -->
  <!-- Tool center point at the tip of the gripper jaws, where the dental
       instrument would be mounted. Used by align_base / start_pose logic. -->
  <joint name="tcp_joint" type="fixed">
    <parent link="gripper_base_link"/>
    <child link="tcp_link"/>
    <origin xyz="0 0 0.09" rpy="0 0 0"/>
  </joint>

  <link name="tcp_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.001"/>
      <inertia ixx="0.000001" ixy="0" ixz="0" iyy="0.000001" iyz="0" izz="0.000001"/>
    </inertial>
  </link>

  <!-- ==================== Wrist Camera Frame ========================== -->
  <!-- Handeye camera (CAM index 1) mounted on the wrist, matching the
       HANDEYE_CAM convention in dental_robot/config.py -->
  <joint name="handeye_cam_joint" type="fixed">
    <parent link="wrist_link"/>
    <child link="handeye_cam_link"/>
    <origin xyz="0 0.025 0.045" rpy="0 1.5708 0"/>
  </joint>

  <link name="handeye_cam_link">
    <visual>
      <geometry>
        <box size="0.015 0.015 0.015"/>
      </geometry>
      <material name="so101_black"/>
    </visual>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.01"/>
      <inertia ixx="0.000001" ixy="0" ixz="0" iyy="0.000001" iyz="0" izz="0.000001"/>
    </inertial>
  </link>

</robot>
